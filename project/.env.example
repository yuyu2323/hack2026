# 실제 설정은 scripts/local_runtime.py가 .local/runtime.env에 생성합니다.
DATABASE_URL=postgresql+psycopg://storeloop:REPLACE_ME@127.0.0.1:55442/storeloop
STORELOOP_TEST_DATABASE_URL=postgresql+psycopg://storeloop:REPLACE_ME@127.0.0.1:55442/storeloop_test
AI_SERVICE_URL=http://127.0.0.1:8202
AI_SERVICE_TOKEN=REPLACE_ME
CODEX_BIN=codex
CODEX_MODEL=gpt-6-astra
CODEX_REASONING_EFFORT=low
SESSION_COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:5182,http://localhost:5182
SESSION_COOKIE_NAME=storeloop_concept_02_session

# codex 또는 openai. API 키는 AI 서버에서만 사용합니다.
AI_PROVIDER=codex
AI_REQUESTS_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_OUTPUT_TOKENS=6000
